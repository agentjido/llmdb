# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# The published history bundle carries this large generated checkpoint.
/priv/llm_db/history/state.json
/priv/llm_db/history/.incremental-transaction/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
llm_db-*.tar

# Environment variables with API keys
.env

# NPM workspace artifacts. The NPM package is generated downstream from the
# canonical Elixir snapshot and the repository license.
/node_modules/
/packages/llmdb/dist/
/packages/llmdb/generated/
/packages/llmdb/LICENSE
/packages/llmdb/src/generated/
/packages/llmdb/src/providers/
/packages/llmdb/*.tgz
